\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{apart-sprint}[2026/09/12 Local LaTeX adaptation of Apart's DOCX template]
\RequirePackage[letterpaper,margin=1in]{geometry}
\RequirePackage{fontspec}
\setmainfont{OldStandard}[Path=fonts/,Extension=.ttf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Italic]
\RequirePackage{graphicx,booktabs,tabularx,longtable}
\RequirePackage{microtype}
\RequirePackage{titlesec}
\titleformat{\section}{\normalfont\fontsize{14}{17}\selectfont\bfseries}{\thesection.}{0.5em}{}
\titleformat{\subsection}{\normalfont\fontsize{13}{16}\selectfont\bfseries}{\thesubsection}{0.5em}{}
\titlespacing*{\section}{0pt}{12pt}{5pt}
\titlespacing*{\subsection}{0pt}{8pt}{3pt}
\RequirePackage[font=small,labelfont=bf]{caption}
\RequirePackage[numbers,sort&compress]{natbib}
\RequirePackage{xurl}
\RequirePackage[hidelinks]{hyperref}
\urlstyle{same}
\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt}
\linespread{1.05}
\setlength{\textfloatsep}{12pt}
\setlength{\intextsep}{10pt}
\setcounter{topnumber}{2}
\renewcommand{\topfraction}{.9}
\renewcommand{\textfraction}{.08}
\setlength{\emergencystretch}{1.5em}
\newcommand{\aparttitle}[1]{%
  \begin{center}
  \hrule height 2pt\vspace{10pt}
  {\fontsize{20}{23}\selectfont\bfseries #1\par}
  \vspace{9pt}\hrule height .4pt\vspace{9pt}
  \input{authors}\\[5pt]
  {\small With Apart Research\\AI Incident Response Sprint, September 2026}
  \end{center}}
% This is a transparent local adaptation, not an official Apart LaTeX class.
